# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.swp
*.swo

# Cài đặt môi trường ảo
venv/
.venv/
env/

# Môi trường cấu hình bảo mật
.env

# Khóa riêng tư SSH
*.key
server.key
*.pem

# Tài liệu PDF, Word và các tệp nén nhị phân
*.pdf
*.docx
*.zip
*.tar.gz
*.rar
*.7z

# Script sinh tài liệu báo cáo cũ / Lab tạm
build_*_pdf.py
generate_*_pdf.py
attack_lab_generator.py

# Mẫu mã độc thu thập (Quarantine - chỉ lưu .gitkeep)
quarantine/*
!quarantine/.gitkeep

# Nhật ký sự kiện thời gian thực (chỉ lưu .gitkeep)
logs/*
!logs/.gitkeep

# Dữ liệu chạy tạm trong benchmark (chỉ giữ run-2026-11-06-train-5000)
data/raw/run-2026-11-08-*
data/raw/run-*-test*
data/raw/*.zip

# File log runtime
*.log

# IDE & Editor
.vscode/
.idea/

# Script đồng bộ máy ảo nội bộ
sync_to_vm.py
