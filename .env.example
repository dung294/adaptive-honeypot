# ==========================================
# CẤU HÌNH KẾT NỐI VÀ QUẢN TRỊ VIÊN TỪ XA (ADMIN REMOTE CONTROL)
# ==========================================

# Địa chỉ IP và Port lắng nghe của SSH Gateway
# Mặc định lắng nghe trên mọi card mạng (0.0.0.0) tại cổng 2222
SSH_HOST=0.0.0.0
SSH_PORT=2222

# Bật/tắt tính năng quản trị từ xa
ADMIN_ENABLED=true

# Tài khoản Admin dùng để SSH từ máy Windows vào điều khiển máy chủ thật
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Danh sách IP được phép đăng nhập Admin (Bảo mật: ngăn kẻ lạ dò pass admin)
# Đặt là '*' để cho phép kết nối từ mọi IP, hoặc điền IP cụ thể (ví dụ: '192.168.1.5, 10.0.0.2')
ADMIN_ALLOWED_IPS=*

# ==========================================
# CẤU HÌNH XÁC THỰC BẪY HONEYPOT (DECEPTION AUTH)
# ==========================================

# Danh sách mật khẩu được Honeypot chấp nhận (Không phải pass nào cũng vào được)
# Nếu hacker nhập pass không nằm trong danh sách này, SSH server sẽ từ chối truy cập (Permission Denied)
# và tự động ghi log sự kiện Brute Force (MITRE T1110)
HONEYPOT_ALLOWED_PASSWORDS=123456,root,password,admin,ubuntu,toor,supersecretpassword123

# Danh sách user được phép vào honeypot ('*' = mọi user)
HONEYPOT_ALLOWED_USERS=*

# Chế độ bẫy (Deception):
# - false (Khuyên dùng): Hacker nhập đúng pass trong danh sách trên sẽ được đưa vào honeypot ảo VFS+LLM để thu thập mẫu
# - true: Chỉ tài khoản Admin mới được kết nối, từ chối mọi kết nối khác
HONEYPOT_STRICT_AUTH=false


# ==========================================
# CẤU HÌNH AI / LLM ENGINE CHO HONEYPOT
# ==========================================
# Mặc định dùng Heuristic / Fast-Path VFS (< 0.1ms, chỉ tốn vài chục MB RAM, không tràn RAM)
LLM_PROVIDER=heuristic
LLM_TIMEOUT_SECONDS=5.0

# ==========================================
# CẤU HÌNH WEB DECOY & BẮN LOG SANG MÁY 1 (TRUNG TÂM SOC & AI PIPELINE)
# ==========================================
WEB_HOST=0.0.0.0
WEB_PORT=80
# Địa chỉ IP của Máy 1 (Lấy từ banner trên SOC Dashboard Máy 1)
PIPELINE_URL=http://172.18.0.5:8000/api/analyze


