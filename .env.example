# ==========================================
# CẤU HÌNH KẾT NỐI VÀ QUẢN TRỊ VIÊN TỪ XA (ADMIN REMOTE CONTROL)
# ==========================================

# Địa chỉ IP và Port lắng nghe của SSH Gateway
# Mặc định lắng nghe trên mọi card mạng (0.0.0.0) tại cổng 2222
SSH_HOST=0.0.0.0
SSH_PORT=2222

# Bật/tắt tính năng quản trị từ xa
ADMIN_ENABLED=true

# Tài khoản Admin dùng để SSH từ máy Windows vào điều khiển máy chủ thật
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Danh sách IP được phép đăng nhập Admin (Bảo mật: ngăn kẻ lạ dò pass admin)
# Đặt là '*' để cho phép kết nối từ mọi IP, hoặc điền IP cụ thể (ví dụ: '192.168.1.5, 10.0.0.2')
ADMIN_ALLOWED_IPS=*

# Chế độ bẫy (Deception):
# - false (Khuyên dùng): Bất kỳ ai đăng nhập bằng user/pass khác admin đều được cho vào honeypot ảo VFS+LLM để thu thập mẫu
# - true: Chỉ tài khoản Admin mới được kết nối, từ chối mọi kết nối khác
HONEYPOT_STRICT_AUTH=false


# ==========================================
# CẤU HÌNH AI / LLM ENGINE CHO HONEYPOT
# ==========================================

# 1. Local Ollama (Mặc định - Miễn phí, chạy trên máy cá nhân)
LLM_PROVIDER=ollama
OLLAMA_API_URL=http://localhost:11434/api/generate
LLM_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SECONDS=5.0

# 2. Groq Cloud (KHUYẾN NGHỊ: Siêu tốc <300ms, rất khó bị phát hiện honeypot, có free tier)
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TIMEOUT_SECONDS=3.0

# 3. OpenAI (GPT-4o mini hoặc GPT-4o)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-...
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=4.0

# 4. DeepSeek (Chi phí siêu rẻ, xử lý lệnh Linux rất chuẩn)
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# LLM_TIMEOUT_SECONDS=4.0

# 5. Google Gemini (Tương thích chuẩn OpenAI endpoint)
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSy...
# LLM_MODEL=gemini-1.5-flash
# LLM_TIMEOUT_SECONDS=4.0

# 6. Anthropic Claude (Claude 3.5 Haiku)
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-haiku-20241022
# LLM_TIMEOUT_SECONDS=4.0

# 7. OpenRouter (Tất cả model trên thị trường)
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# LLM_TIMEOUT_SECONDS=4.0

# 8. Custom OpenAI-compatible Server (vLLM / LM Studio / Text-Gen-WebUI)
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:8000/v1/chat/completions
# LLM_MODEL=local-model
# LLM_API_KEY=none

# 9. Heuristic Mode (0% AI, không cần mạng/GPU, chạy bằng rule giả lập thông minh)
# LLM_PROVIDER=heuristic
